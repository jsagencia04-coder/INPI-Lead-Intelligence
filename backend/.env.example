# Local: postgres do docker-compose. Supabase: Project Settings > Database > Connection string (Session pooler)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inpi

# dev = sem login | supabase = exige JWT do Supabase Auth
AUTH_MODE=dev
SUPABASE_URL=
# só para projetos com chave JWT legada (HS256)
SUPABASE_JWT_SECRET=
# NUNCA expor no frontend
SUPABASE_SERVICE_ROLE_KEY=

# local | supabase
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
STORAGE_BUCKET=rpi-originais

CORS_ORIGINS=["http://localhost:3000"]
WORKER_ID=worker-local

# --- RPI (Fase 2) ---
RPI_INDEX_URL=https://revistas.inpi.gov.br/rpi/
# Primeira edição a importar (ex.: 2900). Vazio = só a mais recente quando o banco está vazio.
RPI_START_EDITION=
RPI_MAX_EDITIONS_PER_RUN=10
# PDFs de marcas: ~150 MB por semana. O XML oficial é a fonte estruturada.
RPI_DOWNLOAD_PDF=false
# alvo = só processos com despachos que geram leads | todos = edição inteira
RPI_IMPORT_SCOPE=alvo

# --- Fase 3: verificação no INPI (pePI) ---
# pausa entre consultas (respeito ao servidor do INPI)
PEPI_INTERVALO_SEGUNDOS=3
# processos enfileirados por hora
PEPI_LOTE_POR_EXECUCAO=100
PEPI_REVERIFICAR_DIAS=30

# --- Fase 4: base CNPJ da Receita ---
# zips do mês (~8 GB). O agendamento vem DESLIGADO (tela Operação).
CNPJ_CACHE_DIR=./data/cnpj
# vazio = mais recente (ex.: 2026-10)
CNPJ_MES=

# --- Fase 4: pesquisa web com Claude ---
# sem chave, a pesquisa e os resumos com IA não rodam (nada é gasto)
ANTHROPIC_API_KEY=
MODELO_PESQUISA=claude-sonnet-5-5
MODELO_RESUMO=claude-haiku-5-5
# buscas web por titular (US$ 0,01 cada)
PESQUISA_MAX_BUSCAS=4
PESQUISA_LOTE_POR_EXECUCAO=20
# a pesquisa para ao atingir este gasto na semana
IA_ORCAMENTO_SEMANAL_USD=20
# Preços por milhão de tokens; confira em https://www.anthropic.com/pricing
PRECO_PESQUISA_IN=3
PRECO_PESQUISA_OUT=15
PRECO_RESUMO_IN=1
PRECO_RESUMO_OUT=5

# --- Fase 5: validação de contatos ---
VALIDAR_BUSCAR_PAGINA=true
VALIDAR_DNS_MX=true

# --- Pesquisa gratuita (sites oficiais, sem IA) ---
# pausa entre requisições ao mesmo site
SITE_INTERVALO_SEGUNDOS=1
# titulares visitados por hora
SITE_LOTE_POR_EXECUCAO=50

# ---------------------------------------------------------------------------
# WhatsApp Business Platform (Cloud API oficial da Meta). Veja docs/WHATSAPP_API.md
# Deixe tudo vazio para manter o sistema em SIMULAÇÃO (nada é enviado).
# ---------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_ENVIO_ATIVO=false
WHATSAPP_NUMEROS_TESTE=
WHATSAPP_LIMITE_POR_MINUTO=10
WHATSAPP_LIMITE_POR_DIA=50

# ---------------------------------------------------------------------------
# Segurança (veja docs/SEGURANCA.md)
# ---------------------------------------------------------------------------
# demo = testes, sem login, aceita dados fictícios | homologacao | producao (login obrigatório)
APP_ENV=demo
# dev = sem login (só no demo) | local = login próprio (recomendado) | supabase
# AUTH_MODE=local
# Assina as sessões do login próprio. Gere um valor longo e aleatório (32+ caracteres) e não divulgue.
APP_SECRET_KEY=
# Primeiro administrador: criado ao iniciar, apenas se ainda não houver nenhum usuário.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
